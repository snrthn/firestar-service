<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <!-- 技术栈文档指定 Spring Boot 3.3.x；Java 17（jakarta 命名空间） -->
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>com.firestar</groupId>
    <artifactId>firestar-parent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>firestar-parent</name>
    <description>火星财务 - 多模块父工程（core 平台内核 / biz 火星业务 / server 应用入口）</description>

    <properties>
        <java.version>17</java.version>
        <!-- 显式锁 javac 的 release=17（2026-11-18 实锤；注意 XML 注释内不能出现连续两个减号，
             所以这里不写命令行开关原样写法）：
             spring-boot-starter-parent 只把 java.version 派生给 maven.compiler.source/target，
             而 source/target 并【不限定 API】——用 JDK 21/25 编译时仍会产出 class major 65/69，
             下游用 JDK 17 运行直接 UnsupportedClassVersionError（surefire 报错还会指向随机某个
             测试类，极易误判成业务代码问题）。
             锁 release 后：任何 JDK 编译都强制产出 major 61，且只允许使用 Java 17 API；
             VS Code 的 Java 扩展（jdt.ls）也读这个属性作为项目 compliance。 -->
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- 子依赖版本（技术栈文档锁定） -->
        <mybatis-plus.version>3.5.7</mybatis-plus.version>
        <flowable.version>7.1.0</flowable.version>
        <hutool.version>5.8.32</hutool.version>
        <springdoc.version>2.6.0</springdoc.version>
        <aliyun.oss.version>3.18.5</aliyun.oss.version>
        <maven-compiler-plugin.version>3.10.1</maven-compiler-plugin.version>
        <maven-jar-plugin.version>3.3.0</maven-jar-plugin.version>
        <jacoco.version>0.8.11</jacoco.version>
    </properties>

    <modules>
        <module>firestar-core</module>
        <module>firestar-biz</module>
        <module>firestar-server</module>
    </modules>
</project>
