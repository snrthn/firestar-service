# ============================================================
# 本地凭据模板（入库）— 复制为 .env/<profile>.env 后把占位值替换为真实值
# 规则:
#   1. 真实文件 .env/dev.env / test.env / pre.env / prod.env 一律不入库（.gitignore 已排除 .env/* 只保留本文件）。
#   2. 本文件占位 KEY 均为 KEY=__FILL_ME__：载入后即生效为占位值，复制为真实文件后
#      【必须】把对应 KEY 改成真实值，否则应用启动会因拿到 __FILL_ME__ 而失败（这正是占位意图）。
#   3. 键名 = 对应 application-<profile>.properties 里的 ${...} 占位符，一一对应（见下方分组说明）。
#   4. 生产/预发/测试凭据优先配在云效 Secrets；deploy.sh 部署时把它们全量镜像写入
#      ECS 的 .env/prod.env，运行时（手动重启/运维台重启/systemd 宿主重启）只认该文件。
#
# 使用: cp .env/example.env .env/dev.env && 把 __FILL_ME__ 替换为真实值
# 消费: bin/start.sh 启动时调用 load_env 载入 .env/<profile>.env（逐行读取 + export，
#      自动处理值内的 & 等 shell 元字符）。因此本文件【无需、也不要】给值加引号，
#      保持与云效 Secrets 完全一致的纯文本写法即可。
# ============================================================

# ========== 数据库：所有 profile 的 url 统一由整串 DB_URL 提供 ==========
# application-{dev,pre,test,prod}.properties 均为 spring.datasource.url=${DB_URL}
# 完整 JDBC URL（含 host/port/库名/连接参数），例如：
#   jdbc:mysql://host:3306/firestar?useSSL=false&serverTimezone=Asia/Shanghai&characterEncoding=utf8&allowPublicKeyRetrieval=true&nullCatalogMeansCurrent=true
#   - dev=.../firestar；pre=.../firestar_pre；test=.../firestar_test；prod 由云效 Secrets 注入（deploy.sh 镜像到 .env/prod.env）
DB_URL=__FILL_ME__             # 完整 JDBC URL（含 host/port/库名/参数）
DB_USERNAME=__FILL_ME__        # 数据库账号（与 DB_URL 配套）
DB_PASSWORD=__FILL_ME__        # 数据库密码（与 DB_URL 配套）

# ========== JWT 签名密钥（所有 profile 强制；base 启动即校验，缺了直接失败）==========
# application.properties（base）jwt.secret=${JWT_SECRET}，无默认值 —— 任意 profile 缺了都启动失败
JWT_SECRET=__FILL_ME__         # 生成：openssl rand -base64 48（HS256 要求 ≥32 字节）
                               # ⚠️ 换密钥 = 所有已签发 token 立即失效，全端需重新登录

# ========== AI 密钥加密密钥（SM4 KEK）==========
# 与 application-{dev,pre,test,prod}.properties 的 ai.kek=${AI_KEK} 对应；缺失即启动失败
AI_KEK=__FILL_ME__             # Base64 编码的 SM4 密钥加密密钥

# ========== Coze 插件 HMAC 密钥（来自云效 Secrets / 环境变量）==========
# 与 Coze 平台「自定义插件」配置的公钥一致；application-{dev,pre,test,prod} 均引用 ${COZE_PLUGIN_SECRET}
COZE_PLUGIN_SECRET=__FILL_ME__

# ========== OSS 对象存储（test / pre / prod 用；dev 走本地磁盘不需要）==========
# 建议用 RAM 子账号最小权限：仅目标 Bucket 的 PutObject/GetObject/DeleteObject。
OSS_ENDPOINT=__FILL_ME__
OSS_BUCKET=__FILL_ME__         # test/pre 用 fire-star-stage；prod 用 fire-star-prod
OSS_ACCESS_KEY_ID=__FILL_ME__
OSS_ACCESS_KEY_SECRET=__FILL_ME__
OSS_PUBLIC_DOMAIN=__FILL_ME__  # 已备案自定义域名，签名 URL 与在线预览依赖它

# ========== 存储类型与路径（非凭据，按环境填）==========
# STORAGE_TYPE 可选：application-{dev,pre,test,prod} 已带默认值（dev/it=local，pre/test/prod=oss），
# 一般无需在 .env 显式设置；如需覆盖再填 local 或 oss。
# LOCAL_STORAGE_DIR 仅 dev/it 本地磁盘模式使用。
LOCAL_STORAGE_DIR=__FILL_ME__  # dev 本地磁盘存储根目录
IT_STORAGE_DIR=__FILL_ME__     # 集成测试存储目录

# ========== IT / 集成测试专用凭据（application-it.properties，CI 不依赖外部 MySQL 时用）==========
# application-it.properties 的 url 自带 firestar_test 默认值（无需设），仅凭据可被以下变量覆盖
TEST_DB_USERNAME=__FILL_ME__   # 覆盖 it 连接账号（缺省回落 DB_USERNAME:root）
TEST_DB_PASSWORD=__FILL_ME__   # 覆盖 it 连接密码（缺省回落 DB_PASSWORD）

# ========== 启动参数（【不要】在此配置）==========
# SPRING_PROFILES_ACTIVE 由 bin/start.sh 通过 SPRING_PROFILE 自动注入（-Dspring.profiles.active），
# 不在此模板提供占位，避免复制后误传 __FILL_ME__ 作为不存在的 profile 导致启动异常。
