# ============================================================
# 本地凭据模板（入库）— 复制为 .env/<profile>.env 后填入真实值
# 规则:
#   1. 真实文件 .env/dev.env / test.env / ... 一律不入库（.gitignore 已排除）
#   2. 纯 KEY=value 键值对（无 export、无 shell 逻辑），# 开头为注释
#   3. 键名 = 对应 application-<profile>.properties 里的 ${...} 占位符
#
# 使用: cp .env/example.env .env/dev.env && 填入真实值
# 消费: bin/start.sh 启动时 set -a; source .env/<profile>.env; set +a
# ============================================================

# ---- dev: 消费方 application-dev.properties ----
DB_PASSWORD=本地MySQL的root密码

# ---- test/pre: 消费方 application-{test,pre}.properties ----
# DB_USERNAME=测试库账号
# DB_PASSWORD=测试库密码

# ---- prod: 消费方 application-prod.properties（连 URL 都走注入）----
# DB_URL=jdbc:mysql://prod-db:3306/firestar?useSSL=true&serverTimezone=Asia/Shanghai&characterEncoding=utf8
# DB_USERNAME=生产库账号
# DB_PASSWORD=生产库密码

# ---- OSS 文件存储：test / pre / prod 消费方（dev 走本地磁盘，不需要）----
# ⚠️ AK/SK 一律不入库：填进 .env/<profile>.env，或配到云效 Secrets，
#    由 bin/start.sh 的 `set -a; source` 注入为环境变量。
# 建议用 RAM 子账号并遵循最小权限：只授予目标 Bucket 的 PutObject/GetObject/DeleteObject。
# OSS_ENDPOINT=https://oss.snrthn.com
# OSS_BUCKET=fire-star-stage          # test/pre 用 stage；prod 用 fire-star-prod
# OSS_ACCESS_KEY_ID=RAM 子账号的 AK
# OSS_ACCESS_KEY_SECRET=RAM 子账号的 SK
# OSS_PUBLIC_DOMAIN=oss.snrthn.com    # 已备案自定义域名，签名 URL 与在线预览依赖它
